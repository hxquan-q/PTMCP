{
  "version": "1.0-design",
  "date": "2026-10-30",
  "status": "input-contract-implemented",
  "transport": "streamable-http",
  "endpoint": "/mcp",
  "sessionMode": "STATELESS",
  "tools": [
    {
      "name": "list_databases_and_tables",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "datasource_id"
        ],
        "properties": {
          "datasource_id": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Positive decimal datasource ID from the configured resource catalog."
          },
          "database_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": ""
          },
          "schema_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "PostgreSQL schema name; optional filter, requires database_name. Omit for MySQL (non-empty values are rejected)."
          },
          "keyword": {
            "type": "string",
            "maxLength": 128,
            "description": "Optional table-name search within this datasource and namespace filter.",
            "minLength": 1
          },
          "cursor": {
            "type": "string",
            "maxLength": 2048,
            "description": "",
            "minLength": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "description": ""
          }
        }
      },
      "description": ""
    },
    {
      "name": "get_table_schema",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "datasource_id",
          "database_name",
          "table_names"
        ],
        "properties": {
          "datasource_id": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Positive decimal datasource ID from the configured resource catalog."
          },
          "database_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": ""
          },
          "schema_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "PostgreSQL schema name; required with database_name. Omit for MySQL (non-empty values are rejected)."
          },
          "table_names": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "One to twenty distinct exact table names from the catalog, without database/schema prefixes."
          }
        }
      },
      "description": "Inspect columns, types, keys and administrator-maintained business dictionary "
    },
    {
      "name": "execute_readonly_sql",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "datasource_id",
          "database_name",
          "sql_query"
        ],
        "properties": {
          "datasource_id": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Positive decimal datasource ID from the configured resource catalog."
          },
          "database_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": ""
          },
          "schema_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "PostgreSQL schema name; required with database_name. Omit for MySQL (non-empty values are rejected)."
          },
          "sql_query": {
            "type": "string",
            "minLength": 1,
            "description": ""
          },
          "max_rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 500,
            "description": ""
          }
        }
      },
      "description": ""
    }
  ]
}
