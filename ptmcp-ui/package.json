{
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format:check": "prettier --check src tests",
    "format": "prettier --write src tests",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:public": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:preview": "vite --mode frontend-preview --host 127.0.0.1 --port 5174 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "test:contracts": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.5.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "8.2.2",
    "@vitejs/plugin-vue": "6.0.8",
    "vue-tsc": "3.3.11",
    "@types/node": "24.10.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "unplugin-icons": "24.0.0",
    "unplugin-vue-components": "32.1.0",
    "@iconify-json/ep": "1.2.4"
  },
  "name": "ptmcp-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.9.0"
  },
  "dependencies": {
    "vue": "3.5.42",
    "vue-router": "5.3.1",
    "pinia": "4.0.3",
    "element-plus": "2.14.5",
    "animate.css": "4.1.1",
    "@vueuse/motion": "3.0.3"
  }
}
