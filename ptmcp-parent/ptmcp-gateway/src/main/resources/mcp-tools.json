{
  "version": "1.0-design",
  "date": "2026-10-23",
  "status": "design-not-implemented",
  "transport": "streamable-http",
  "endpoint": "/mcp",
  "sessionMode": "STATELESS",
  "tools": [
    {
      "name": "list_databases_and_tables",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "datasource_id"
        ],
        "properties": {
          "datasource_id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "database_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "schema_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "keyword": {
            "type": "string",
            "maxLength": 128
          },
          "cursor": {
            "type": "string",
            "maxLength": 2048
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        }
      }
    },
    {
      "name": "get_table_schema",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "datasource_id",
          "database_name",
          "table_names"
        ],
        "properties": {
          "datasource_id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "database_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "schema_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "table_names": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    {
      "name": "execute_readonly_sql",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "datasource_id",
          "database_name",
          "sql_query"
        ],
        "properties": {
          "datasource_id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "database_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "schema_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sql_query": {
            "type": "string",
            "minLength": 1
          },
          "max_rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 500
          }
        }
      }
    }
  ]
}
