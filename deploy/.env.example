# PTMCP 生产 Compose 环境样例。
#
# 复制为 deploy/.env 后填写（或运行 deploy/init-env.sh 生成）。.env 已被 git 忽略。
# 必填项故意留空：缺少时 compose 以 :? 报错拒绝启动，不会静默回退到不安全默认值。
# 本文件不含任何真实密钥。

# 本地构建镜像的标签与 UI 入口端口。
PTMCP_IMAGE_TAG=0.1.0
PTMCP_HTTP_PORT=8080

# 浏览器与 Agent 访问的对外基址（协议 + 主机 + 端口，不带路径）。
# HTTPS 部署时改 https://console.example.com，并把两个 *_COOKIE_SECURE 设为 true。
PTMCP_PUBLIC_BASE_URL=http://localhost:8080

# 元库。selfhost 时主机名固定为 compose 服务名 mysql；接外部 MySQL 8.4 时改 JDBC URL。
PTMCP_METADATA_DB_NAME=ptmcp
# 固定服务账号：ptmcp_migrate / ptmcp_admin / ptmcp_authz / ptmcp_gateway。
# init-env.sh 生成独立密码，并写入对应 secrets/mysql_<角色>.txt；不得复用旧共用账号。
PTMCP_METADATA_MIGRATION_PASSWORD=
PTMCP_METADATA_ADMIN_PASSWORD=
PTMCP_METADATA_AUTHZ_PASSWORD=
PTMCP_METADATA_GATEWAY_PASSWORD=
PTMCP_METADATA_JDBC_URL=jdbc:mysql://mysql:3306/ptmcp?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8

# 密钥环。生成方式：openssl rand -base64 32
# admin 与 gateway 必须共用同一组 credential/audit 密钥，否则网关无法解密数据源凭证、审计无法解封。
PTMCP_CREDENTIAL_KEY=
PTMCP_AUDIT_KEY=
PTMCP_GATEWAY_WAL_KEY=

# 业务数据源可达范围（admin 与 gateway 共用）。空 CIDR 表示不允许任何业务地址。
PTMCP_BUSINESS_ALLOWED_CIDRS=
PTMCP_BUSINESS_ALLOWED_PORTS=3306,5432

# 会话 Cookie。纯 HTTP 本地环境必须为 false；HTTPS 上线后设为 true。
PTMCP_ADMIN_COOKIE_SECURE=false
PTMCP_AS_COOKIE_SECURE=false

# OAuth 授权服务。issuer/audience 必须与下方网关值一致，且必须是客户端可达的对外地址。
# 开启后 authz 需要签名私钥：init-env.sh 会在 deploy/secrets/oauth-signing.pem 生成。
PTMCP_OAUTH_ENABLED=true
PTMCP_OAUTH_ISSUER=http://localhost:8080
PTMCP_OAUTH_AUDIENCE=http://localhost:8080/mcp

# MCP 网关。RESOURCE/元数据地址是客户端可达的对外地址；
# JWKS 由网关在 Compose 网络内直连 authz 拉取，避免回环到入口自身。
PTMCP_GATEWAY_ENABLED=true
PTMCP_GATEWAY_ISSUER=http://localhost:8080
PTMCP_GATEWAY_RESOURCE=http://localhost:8080/mcp
PTMCP_GATEWAY_RESOURCE_URI=http://localhost:8080/mcp
PTMCP_GATEWAY_JWKS_URI=http://authz:8081/oauth2/jwks
PTMCP_GATEWAY_RESOURCE_METADATA_URI=http://localhost:8080/.well-known/oauth-protected-resource
PTMCP_MCP_URL=http://localhost:8080/mcp
