# ── PTMCP · 服务器运行配置模板（Windows）────────────────────────────
#
# 安装位置：<部署根>\shared\config\app.env（升级不覆盖）。
# 逐行 KEY=VALUE 解析，不执行 PowerShell；注释独占一行；值含空格用单引号。
# ────────────────────────────────────────────────────────────────────

# ── 对外入口（nginx 监听）──
PTMCP_HTTP_PORT=@HTTP_PORT@
PTMCP_PUBLIC_BASE_URL=@PUBLIC_BASE_URL@

# ── 三个后端端口（只监听 127.0.0.1，不对外）──
PTMCP_ADMIN_PORT=18080
PTMCP_AUTHZ_PORT=18081
PTMCP_GATEWAY_PORT=18082

# ── 元库（MySQL 8）──
# 库与账号需事先建好；表结构由 4-migrate.cmd（Flyway）创建。
PTMCP_METADATA_JDBC_URL=jdbc:mysql://127.0.0.1:3306/ptmcp?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
PTMCP_METADATA_DB_USERNAME=ptmcp
PTMCP_METADATA_DB_PASSWORD=CHANGE_ME

# ── 密钥环（init-env 已生成，切勿跨环境混用）──
PTMCP_CREDENTIAL_KEY=@CREDENTIAL_KEY@
PTMCP_AUDIT_KEY=@AUDIT_KEY@
PTMCP_GATEWAY_WAL_KEY=@WAL_KEY@

# 留空则使用 <部署根>\shared\config\secrets\oauth-signing.pem。
PTMCP_OAUTH_SIGNING_KEY_FILE=

# HTTPS 部署时置 true（同时把 PUBLIC_BASE_URL 改为 https://）。
PTMCP_ADMIN_COOKIE_SECURE=@COOKIE_SECURE@
PTMCP_AS_COOKIE_SECURE=@COOKIE_SECURE@

# ── 业务库访问边界 ──
PTMCP_BUSINESS_ALLOWED_CIDRS=127.0.0.1/32
PTMCP_BUSINESS_ALLOWED_PORTS=3306,5432

# ── 运行时 ──
# 留空则使用 PATH 上的 java / nginx.exe；建议填绝对路径：
#   JAVA_EXE=C:\Program Files\Eclipse Adoptium\jdk-21\bin\java.exe
#   NGINX_EXE=C:\ptmcp\nginx\nginx.exe
JAVA_EXE=
NGINX_EXE=
# 首次迁移若用 Flyway CLI，可填其绝对路径；留空则找 PATH 上的 flyway。
FLYWAY_EXE=
PTMCP_JAVA_OPTS=-Xms256m -Xmx768m
PTMCP_START_TIMEOUT=240
