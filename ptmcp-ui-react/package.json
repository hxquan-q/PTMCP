{
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format:check": "prettier --check src tests",
    "format": "prettier --write src tests",
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "dev:public": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:preview": "vite --mode frontend-preview --host 127.0.0.1 --port 5175 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "8.2.2",
    "@types/node": "24.10.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.1.1"
  },
  "name": "ptmcp-ui-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.9.0"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
